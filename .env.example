# API key for securing the /execute endpoint — CHANGE THIS before deploying!
API_KEY=change-me-before-deploy

# Number of uvicorn workers (keep at 1 for the sandbox to work correctly)
WORKERS=1
# --- AWS Credentials ---
# Required if you are NOT using an IAM instance role on an EC2 instance
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
